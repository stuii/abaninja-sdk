{
  "name": "stui/abaninja-sdk",
  "description": "SDK for the public AbaNinja API",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Stui\\AbaNinja\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stui\\AbaNinja\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "stui",
      "email": "me@stui.ch"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "symfony/uid": "^7.3 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "vlucas/phpdotenv": "^5.6"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  }
}
